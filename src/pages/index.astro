---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Starfield from '../components/Starfield.astro';
import Icon from '../components/Icon.astro';
import Sections from '../components/Sections.astro';
import { site, profileLinks, PROFILE_LABELS } from '../data/site';

const home = await getEntry('pages', 'home');
// Everything below the hero comes from the page's own layout array, so the
// order of the sections is content rather than markup and can be changed
// from the page itself.
const layout = home!.data.layout ?? [];

const ICONS: Record<string, 'orcid' | 'scholar' | 'github' | 'external'> = {
  orcid: 'orcid', scholar: 'scholar', github: 'github',
};
---
<Base title={site.name} description={site.description}>
  <!-- Hero: the first element on the site that escapes the wrapper. -->
  <section class="hero full-bleed">
    <Starfield count={80} />
    <div class="wrap hero__inner">
      {home?.data.cover && (
        <Image
          src={home.data.cover}
          alt={home.data.coverAlt || site.name}
          width={240} height={300}
          class="hero__photo"
          loading="eager"
        />
      )}
      <div class="hero__text">
        {/* The hero stays fixed at the top of the page rather than being a
            movable section, but its words live in site.json and are editable
            in place like everything else. */}
        <h1 data-edit="site.json#site.name">{site.name}</h1>
        <p class="hero__role" data-edit="site.json#site.role">{site.role}</p>
        <p class="hero__affil">
          <span data-edit="site.json#site.affiliation.org">{site.affiliation.org}</span><br />
          <span data-edit="site.json#site.affiliation.institution">{site.affiliation.institution}</span>
          · <span data-edit="site.json#site.affiliation.location">{site.affiliation.location}</span>
        </p>
        <div class="hero__actions">
          <a class="btn" href={`mailto:${site.email}`}><Icon name="mail" /> Email</a>
          <a class="btn btn--ghost" href={site.cv}>Curriculum Vitae</a>
        </div>
        {profileLinks.length > 0 && (
          <ul class="hero__links">
            {profileLinks.map((p) => (
              <li>
                <a href={p.url} rel="me noopener" target="_blank">
                  <Icon name={ICONS[p.key] ?? 'external'} size={16} />
                  {PROFILE_LABELS[p.key] ?? p.key}
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
  </section>

  <div class="wrap">
    <Sections sections={layout} file="pages/home.md" />
  </div>
</Base>

<style>
  /* ---- Hero ---- */
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--surface);
    border-block-end: 1px solid var(--border);
    padding-block: var(--space-10);
    margin-block-end: var(--space-10);
  }
  .hero__inner {
    position: relative;   /* above the starfield */
    display: flex;
    gap: var(--space-7);
    align-items: center;
    flex-wrap: wrap;
  }
  .hero__photo {
    border-radius: var(--radius-lg);
    object-fit: cover;
    box-shadow: var(--shadow-md);
  }
  .hero__text { flex: 1 1 22rem; display: flex; flex-direction: column; gap: var(--space-3); }
  .hero__text h1 { font-size: var(--step-6); margin: 0; }
  .hero__role {
    font-family: var(--font-sans);
    font-size: var(--step-1);
    font-weight: 550;
    color: var(--accent-2);
    letter-spacing: 0.01em;
  }
  .hero__affil { color: var(--text-muted); line-height: 1.7; }
  .hero__actions { display: flex; gap: var(--space-3); flex-wrap: wrap; margin-block-start: var(--space-2); }
  .hero__actions :global(.icon) { margin-inline-end: var(--space-2); }
  .hero__links { display: flex; gap: var(--space-4); flex-wrap: wrap; list-style: none; padding: 0; margin-block-start: var(--space-2); }
  .hero__links a {
    display: inline-flex; align-items: center; gap: var(--space-2);
    font-size: var(--step--1); text-decoration: none; color: var(--text-muted);
  }
  .hero__links a:hover { color: var(--accent); }

  /* ---- Bio + rail ---- */
</style>
