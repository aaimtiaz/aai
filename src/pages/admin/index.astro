---
import Base from '../../layouts/Base.astro';
---
<Base title="Publish" noindex analytics={false}>
  <div class="wrap admin">

    <!-- Login -->
    <section id="login-panel" hidden>
      <h1>Publish</h1>
      <p class="muted">
        Paste a GitHub <strong>fine-grained personal access token</strong> scoped to the
        <code>aaimtiaz.github.io</code> repository only, with
        <strong>Contents: Read and write</strong> and nothing else.
        <a href="https://github.com/settings/personal-access-tokens/new" target="_blank" rel="noopener">Create one &#8599;</a>
      </p>
      <label for="token">GitHub token</label>
      <input type="password" id="token" autocomplete="off" placeholder="github_pat_..." />
      <label class="checkbox">
        <input type="checkbox" id="remember" /> Stay signed in on this device
      </label>
      <button class="btn" id="login-btn">Sign in</button>
      <p id="login-status" class="status" role="status" aria-live="polite"></p>
    </section>

    <!-- Editor -->
    <section id="app" hidden>
      <header class="admin__bar">
        <h1 id="editor-title">New post</h1>
        <div class="admin__bar-actions">
          <span id="whoami" class="muted small"></span>
          <button class="btn btn--ghost" id="logout-btn" type="button">Sign out</button>
        </div>
      </header>

      <nav class="tabs" aria-label="Sections">
        <button type="button" data-view="editor" aria-pressed="true">Write</button>
        <button type="button" data-view="list" aria-pressed="false">Posts</button>
      </nav>

      <!-- Editor view -->
      <div id="view-editor">
        <form id="post-form">
          <div class="row">
            <div>
              <label for="collection">Section</label>
              <select id="collection">
                <option value="writing">Writing</option>
                <option value="travel">Travel</option>
                <option value="outreach">Outreach</option>
                <option value="teaching">Teaching</option>
              </select>
            </div>
            <div>
              <label for="lang">Language</label>
              <select id="lang">
                <option value="en">English</option>
                <option value="bn">বাংলা</option>
              </select>
            </div>
          </div>

          <label for="title">Title</label>
          <input type="text" id="title" required autocapitalize="sentences" />

          <label for="slug">URL slug <span class="muted">— filled in from the title</span></label>
          <input type="text" id="slug" />

          <div class="row" data-only="writing">
            <div>
              <label for="form-field">Form</label>
              <select id="form-field">
                <option value="poem">Poem</option>
                <option value="prose">Prose</option>
              </select>
            </div>
          </div>

          <div class="row">
            <div>
              <label for="date">Date</label>
              <input type="date" id="date" />
            </div>
            <div>
              <label for="dateNote">Date note <span class="muted">— optional</span></label>
              <input type="text" id="dateNote" placeholder="e.g. খুব সম্ভবত ২০২২" />
            </div>
          </div>
          <p class="hint">
            The date orders posts and feeds. If the real date is a guess, put the honest
            version in the note — that is what readers actually see.
          </p>

          <div data-only="travel">
            <label for="location">Place</label>
            <input type="text" id="location" placeholder="e.g. Bandarban" />
          </div>

          <label for="image">Images</label>
          <input type="file" id="image" accept="image/*" multiple />
          <p class="hint" id="image-info">
            Pick as many as you like at once. Each is resized and converted to WebP
            before it is uploaded, so choose the full-size originals.
          </p>

          <ul id="image-list" class="imglist"></ul>
          <p class="hint" id="image-empty">No images on this post yet.</p>
          <p class="hint">
            <strong>Cover</strong> sits above the text. <strong>In the text</strong> places
            the photo where your cursor is, so you can alternate writing and pictures.
            <strong>Gallery</strong> photos follow the text as a grid, in the order below.
          </p>

          <label for="excerpt">Excerpt <span class="muted">— optional, shown on cards</span></label>
          <input type="text" id="excerpt" />

          <label for="tags">Tags <span class="muted">— comma separated</span></label>
          <input type="text" id="tags" list="known-tags" />
          <datalist id="known-tags"></datalist>

          <div class="editor-head">
            <label for="body">Post</label>
            <div class="tabs tabs--small">
              <button type="button" data-pane="write" aria-pressed="true">Write</button>
              <button type="button" data-pane="preview" aria-pressed="false">Preview</button>
            </div>
          </div>

          <div class="toolbar" id="toolbar">
            <button type="button" data-wrap="**" title="Bold" aria-label="Bold"><b>B</b></button>
            <button type="button" data-wrap="_" title="Italic" aria-label="Italic"><i>I</i></button>
            <button type="button" data-prefix="## " title="Heading" aria-label="Heading">H2</button>
            <button type="button" data-prefix="&gt; " title="Quote" aria-label="Quote">&rdquo;</button>
            <button type="button" data-prefix="- " title="Bullet list" aria-label="Bullet list">&bull;</button>
            <button type="button" data-link title="Link" aria-label="Link">Link</button>
          </div>

          <textarea id="body" rows="14" required autocapitalize="sentences"
                    placeholder="Write here. Markdown works, and a single newline stays a line break — so poems look the way you type them."></textarea>
          <div id="preview" class="preview" hidden></div>

          <label for="note">Closing note <span class="muted">— optional</span></label>
          <textarea id="note" rows="2"></textarea>

          <p id="autosave" class="muted small"></p>

          <div class="actions">
            <button class="btn" id="publish-btn" type="submit">Publish</button>
            <button class="btn btn--ghost" id="draft-btn" type="button">Save draft</button>
            <button class="btn btn--ghost" id="new-btn" type="button">New</button>
            <button class="btn btn--danger" id="delete-btn" type="button" hidden>Delete</button>
          </div>
        </form>

        <div id="status" class="status" role="status" aria-live="polite"></div>
      </div>

      <!-- Post list -->
      <div id="view-list" hidden>
        <div class="list-head">
          <div class="list-filters">
            <label class="inline" for="list-filter">Show</label>
            <select id="list-filter">
              <option value="drafts">Drafts only</option>
              <option value="all">Everything</option>
              <option value="published">Live only</option>
              <option value="imported">Imported from Facebook</option>
            </select>

            <label class="inline" for="list-section">Section</label>
            <select id="list-section">
              <option value="all">All</option>
              <option value="writing">Writing</option>
              <option value="travel">Travel</option>
              <option value="research">Research</option>
              <option value="teaching">Teaching</option>
              <option value="outreach">Outreach</option>
            </select>
          </div>
          <div class="list-tools">
            <button class="btn btn--ghost btn--sm" id="select-all" type="button">Select all shown</button>
            <button class="btn btn--ghost btn--sm" id="refresh-btn" type="button">Refresh</button>
          </div>
        </div>

        <p id="list-status" class="muted" role="status" aria-live="polite">Loading…</p>

        <!-- Bulk actions apply as ONE commit, so clearing out a hundred
             imported drafts is a single rebuild rather than a hundred. -->
        <div id="bulk-bar" class="bulk-bar" hidden>
          <span><strong id="bulk-count">0</strong> selected</span>
          <div class="bulk-bar__actions">
            <button class="btn btn--sm" id="bulk-publish" type="button">Publish</button>
            <button class="btn btn--ghost btn--sm" id="bulk-unpublish" type="button">Make draft</button>
            <button class="btn btn--danger btn--sm" id="bulk-delete" type="button">Delete</button>
          </div>
        </div>

        <ul id="post-list" class="post-list"></ul>
      </div>
    </section>
  </div>
</Base>

<script src="../../scripts/admin/main.ts"></script>

<style>
  .admin { max-width: 44rem; }
  .admin h1 { font-size: var(--step-3); }
  .muted { color: var(--text-muted); }
  .small { font-size: var(--step--1); }

  .admin :global(label) {
    display: block; font-weight: 600; margin-block: var(--space-5) var(--space-2);
  }
  .admin :global(label.checkbox) {
    font-weight: 400; display: flex; align-items: center; gap: var(--space-2); margin-block: var(--space-4);
  }
  .admin :global(input[type="text"]),
  .admin :global(input[type="password"]),
  .admin :global(input[type="date"]),
  .admin :global(input[type="file"]),
  .admin :global(textarea),
  .admin :global(select) {
    width: 100%;
    /* 16px minimum: below this, iOS Safari zooms on focus and the layout jumps. */
    font-size: 16px;
    padding: var(--space-3);
    min-height: 44px;
    background: var(--bg); color: var(--text);
    border: 1px solid var(--border-strong); border-radius: var(--radius-sm);
  }
  .admin :global(textarea) { resize: vertical; line-height: 1.7; }
  .admin :global(input[type="checkbox"]) { width: auto; min-height: 0; }

  .row { display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr)); }
  .hint { color: var(--text-muted); font-size: var(--step--1); margin-block-start: var(--space-2); }

  /* Image manager.
     Rows are built with createElement, so their rules go through :global() —
     Astro scopes styles by stamping data-astro-cid at build time and nothing
     the script creates ever carries it. The <ul> itself is in the markup, so
     it keeps the attribute and anchors the whole block. */
  .imglist { list-style: none; padding: 0; margin-block-start: var(--space-4); display: grid; gap: var(--space-3); }
  .imglist:empty { display: none; }
  .imglist :global(li) {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: var(--space-4);
    padding: var(--space-3);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }
  .imglist :global(li[data-placement="cover"]) { border-color: var(--accent-2); }

  .imglist :global(.imglist__thumb) {
    width: 5.5rem; height: 5.5rem; object-fit: cover;
    border-radius: var(--radius-sm); background: var(--bg); display: block;
  }
  .imglist :global(.imglist__main) { min-width: 0; display: grid; gap: var(--space-2); }
  .imglist :global(.imglist__where) {
    display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap;
    font-size: var(--step--1); color: var(--text-muted);
  }
  .imglist :global(.imglist__badge) {
    font-size: var(--step--2); letter-spacing: 0.06em; text-transform: uppercase;
    padding: 2px var(--space-2); border-radius: 999px;
    background: var(--bg); border: 1px solid var(--border-strong); color: var(--text-muted);
  }
  .imglist :global(li[data-placement="cover"] .imglist__badge) {
    border-color: var(--accent-2); color: var(--accent-2);
  }
  /* Overrides the admin's global field sizing: three stacked 44px inputs per
     row would make a five-image post taller than a phone screen. */
  .imglist :global(input[type="text"]) {
    min-height: 36px; padding: var(--space-2); font-size: var(--step--1);
  }
  .imglist :global(.imglist__actions) { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .imglist :global(.imglist__actions button) {
    min-height: 34px; padding: 0 var(--space-3);
    font-size: var(--step--1); line-height: 1;
    background: var(--bg); color: var(--text);
    border: 1px solid var(--border-strong); border-radius: var(--radius-sm);
    cursor: pointer;
  }
  .imglist :global(.imglist__actions button:hover) { border-color: var(--accent); color: var(--accent); }
  .imglist :global(.imglist__actions button:disabled) { opacity: 0.4; cursor: not-allowed; }
  .imglist :global(.imglist__actions button[data-act="remove"]:hover) { border-color: var(--err); color: var(--err); }

  @media (max-width: 30rem) {
    .imglist :global(li) { grid-template-columns: 3.5rem minmax(0, 1fr); gap: var(--space-3); }
    .imglist :global(.imglist__thumb) { width: 3.5rem; height: 3.5rem; }
  }

  .admin__bar { display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); flex-wrap: wrap; }
  .admin__bar-actions { display: flex; align-items: center; gap: var(--space-3); }

  .tabs { display: flex; gap: var(--space-2); margin-block: var(--space-5); }
  .tabs button {
    min-height: 44px; padding: 0 var(--space-4); cursor: pointer;
    background: none; border: 1px solid var(--border); border-radius: 999px; color: var(--text-muted);
  }
  .tabs button[aria-pressed="true"] { background: var(--accent-subtle); color: var(--accent); border-color: var(--accent); }
  .tabs--small { margin: 0; }

  .editor-head { display: flex; justify-content: space-between; align-items: end; gap: var(--space-4); flex-wrap: wrap; }
  .toolbar { display: flex; gap: var(--space-2); flex-wrap: wrap; margin-block: var(--space-2); }
  .toolbar button {
    min-width: 44px; min-height: 44px; cursor: pointer;
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius-sm); color: var(--text);
  }
  .toolbar button:hover { border-color: var(--accent); color: var(--accent); }

  .preview {
    border: 1px solid var(--border); border-radius: var(--radius-sm);
    padding: var(--space-4); min-height: 12rem; background: var(--surface);
  }
  /* Mirrors the real post page exactly, so the preview tells the truth: poems
     keep their typed line breaks, prose is justified and hyphenated. If these
     two rules drift from writing/[id].astro, the preview starts lying. */
  .preview :global(p + p) { margin-block-start: var(--space-4); }
  .preview.is-poem :global(p) { white-space: pre-line; }
  .preview.is-prose :global(p) {
    text-align: justify;
    hyphens: auto;
    -webkit-hyphens: auto;
  }
  .preview[lang='bn'] :global(p) { hyphens: none; -webkit-hyphens: none; }

  .actions {
    display: flex; gap: var(--space-3); flex-wrap: wrap;
    margin-block-start: var(--space-6);
    position: sticky; bottom: 0; padding-block: var(--space-4);
    background: linear-gradient(to top, var(--bg) 70%, transparent);
  }
  /* .btn / .btn--ghost / .btn--danger / .btn--sm live in global.css.
     They must be global: rows built with createElement never receive the
     data-astro-cid attribute that scoped styles key off. */

  .status {
    margin-block-start: var(--space-4); padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm); white-space: pre-line;
  }
  .status:empty { display: none; }
  .status.ok { background: var(--ok-subtle); color: var(--ok); border: 1px solid var(--ok); }
  .status.err { background: var(--err-subtle); color: var(--err); border: 1px solid var(--err); }
  .status.busy { background: var(--surface); color: var(--text-muted); border: 1px solid var(--border); }

  .list-head { display: flex; justify-content: space-between; align-items: end; gap: var(--space-4); flex-wrap: wrap; }
  .list-filters { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; }
  .list-tools { display: flex; gap: var(--space-2); flex-wrap: wrap; }
  .admin :global(label.inline) { display: inline; margin: 0; font-size: var(--step--1); color: var(--text-muted); font-weight: 500; }
  .list-filters :global(select) { width: auto; min-width: 9rem; }

  .btn--sm { min-height: 38px; padding: 0 var(--space-3); font-size: var(--step--1); }

  /* Sticks to the bottom so the actions stay reachable while scrolling a
     long list of drafts on a phone. */
  .bulk-bar {
    position: sticky; bottom: 0; z-index: 5;
    display: flex; justify-content: space-between; align-items: center;
    gap: var(--space-3); flex-wrap: wrap;
    padding: var(--space-3) var(--space-4); margin-block: var(--space-3);
    border: 1px solid var(--accent); border-radius: var(--radius-sm);
    background: var(--accent-subtle); color: var(--text);
  }
  .bulk-bar__actions { display: flex; gap: var(--space-2); flex-wrap: wrap; }

  .post-list { list-style: none; padding: 0; display: grid; gap: var(--space-3); margin-block-start: var(--space-4); }
  .post-list :global(li) {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start; gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface);
  }
  .post-list :global(.post-list__main) { min-width: 0; }
  .post-list :global(.post-list__meta) { color: var(--text-muted); font-size: var(--step--1); margin-block-start: 2px; }
  .post-list :global(.post-list__excerpt) {
    color: var(--text-muted); font-size: var(--step--1); margin-block-start: var(--space-2);
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .post-list :global(.post-list__actions) { display: flex; gap: var(--space-2); flex-wrap: wrap; justify-content: end; }

  @media (max-width: 34rem) {
    .post-list :global(li) { grid-template-columns: auto 1fr; }
    .post-list :global(.post-list__actions) { grid-column: 2; justify-content: start; }
  }
</style>
