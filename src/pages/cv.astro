---
import Base from '../layouts/Base.astro';
import { site, profileLinks } from '../data/site';
import { getPublished } from '../lib/content';

const research = (await getPublished('research')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const papers = research.filter((r) => r.data.publication);
const labels: Record<string, string> = {
  orcid: 'ORCID', scholar: 'Google Scholar', ads: 'NASA ADS', github: 'GitHub', arxiv: 'arXiv',
};
---
<Base
  title="Curriculum Vitae"
  description={`Curriculum vitae of ${site.name} — observational astrophysics, galaxy evolution and strong gravitational lensing.`}
>
  <div class="wrap cv">
    <header>
      <h1>Curriculum Vitae</h1>
      <p class="lede">
        {site.affiliation.role}, {site.affiliation.org},<br />
        {site.affiliation.institution} · {site.affiliation.location}
      </p>
      <p class="actions">
        <a class="btn" href={site.cv} download>Download PDF</a>
        <a class="btn btn--ghost" href={`mailto:${site.email}`}>Email</a>
      </p>
      {profileLinks.length > 0 && (
        <ul class="tag-list">
          {profileLinks.map((p) => (
            <li><a href={p.url} rel="me noopener" target="_blank">{labels[p.key] ?? p.key} ↗</a></li>
          ))}
        </ul>
      )}
    </header>

    {papers.length > 0 && (
      <section>
        <h2>Publications</h2>
        <ol class="cv-list">
          {papers.map((p) => (
            <li>
              <a href={`/research/${p.id}/`}>{p.data.title}</a>
              <p class="meta">
                {p.data.publication?.venue && <span>{p.data.publication.venue}</span>}
                <span>{p.data.date.getFullYear()}</span>
                {p.data.publication?.role && <span>{p.data.publication.role}</span>}
              </p>
            </li>
          ))}
        </ol>
      </section>
    )}

    <section>
      <h2>Current projects</h2>
      <ol class="cv-list">
        {research.map((r) => (
          <li>
            <a href={`/research/${r.id}/`}>{r.data.title}</a>
            <p class="meta">
              {r.data.supervisor && <span>{r.data.supervisor}</span>}
              <span>{r.data.status}</span>
            </p>
          </li>
        ))}
      </ol>
    </section>

    <p class="note">
      The PDF is the authoritative version — <a href={site.cv}>download it here</a>.
    </p>
  </div>
</Base>
<style>
  .cv { max-width: 52rem; }
  .lede { color: var(--text-muted); margin-block: var(--space-3); line-height: 1.7; }
  .actions { display: flex; gap: var(--space-3); flex-wrap: wrap; margin-block: var(--space-5) var(--space-4); }
  .btn { display: inline-flex; align-items: center; min-height: 44px; padding: 0 var(--space-5);
         border-radius: var(--radius-sm); background: var(--accent); color: var(--accent-contrast);
         text-decoration: none; font-weight: 550; }
  .btn:hover { background: var(--accent-hover); color: var(--accent-contrast); }
  .btn--ghost { background: none; color: var(--accent); border: 1px solid var(--border-strong); }
  .btn--ghost:hover { background: var(--surface); color: var(--accent); }
  section { margin-block-start: var(--space-9); }
  section h2 { margin-block-end: var(--space-4); }
  .cv-list { padding-inline-start: var(--space-5); display: grid; gap: var(--space-4); }
  .cv-list a { color: var(--text); text-decoration: none; font-weight: 550; }
  .cv-list a:hover { color: var(--accent); }
  .cv-list .meta { margin-block-start: var(--space-1); }
  .note { margin-block-start: var(--space-9); color: var(--text-muted); font-size: var(--step--1); }
</style>
