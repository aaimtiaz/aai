---
import Base from '../../layouts/Base.astro';
import Sections from '../../components/Sections.astro';
import { getEntry } from 'astro:content';
import PostCard from '../../components/PostCard.astro';
import { getPublished, byDateDesc } from '../../lib/content';

const all = (await getPublished('writing')).sort(byDateDesc);
const KIND: Record<string, string> = { poem: 'Poem', prose: 'Prose' };

const page = await getEntry('pages', 'writing');
const layout = page!.data.layout ?? [];
---
<Base
  title="Writing"
  description="Poetry and prose in English and Bengali by Ahmad Al-Imtiaz."
>
  <div class="wrap">
    <h1 data-edit="pages/writing.md#title">Writing</h1>
    <Sections sections={layout} file="pages/writing.md">
      <Fragment slot="entries">

    {all.length === 0 ? (
      <p class="empty-state">Nothing published yet.</p>
    ) : (
      <>
        <nav class="filters" aria-label="Filter writing">
          <a href="/writing/" aria-current="page">All</a>
          <a href="/writing/lang/en/">English</a>
          <a href="/writing/lang/bn/">বাংলা</a>
        </nav>
        <div class="grid grid--3">
          {all.map((e) => (
            <PostCard href={`/writing/${e.id}/`} data={e.data} kind={KIND[e.data.form]} />
          ))}
        </div>
      </>
    )}
      </Fragment>
    </Sections>
  </div>
</Base>

<style>
  .lede { font-size: var(--step-1); color: var(--text-muted); margin-block: var(--space-4) var(--space-6); }
  .filters { display: flex; gap: var(--space-2); margin-block-end: var(--space-6); flex-wrap: wrap; }
  .filters a {
    min-height: 44px; display: inline-flex; align-items: center;
    padding: 0 var(--space-4); border: 1px solid var(--border);
    border-radius: 999px; text-decoration: none; color: var(--text-muted);
  }
  .filters a:hover { border-color: var(--accent); color: var(--accent); }
  .filters a[aria-current='page'] { background: var(--accent-subtle); color: var(--accent); border-color: var(--accent); }
</style>
