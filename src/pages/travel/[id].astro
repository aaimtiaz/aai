---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPublished, displayDate, tagSlug } from '../../lib/content';
import { site } from '../../data/site';
import { articleSchema, crumbsFor } from '../../lib/schema';

export async function getStaticPaths() {
  const all = await getPublished('travel');
  return all.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const url = new URL(Astro.url.pathname, Astro.site).href;
const personId = new URL('/#person', Astro.site).href;
// Astro's processed image, made absolute — this is what makes the entry
// eligible for Article rich results and gives it its own share card.
const ogImage = d.cover?.src ? new URL(d.cover.src, Astro.site).href : undefined;

const schema = [articleSchema({
  type: 'BlogPosting',
  title: d.title,
  url, siteUrl: Astro.site!.href,
  date: d.date,
  updated: d.updated,
  lang: d.lang,
  description: d.excerpt,
  image: ogImage,
  
  authorName: site.name,
  personId,
})];
const crumbs = crumbsFor('travel', 'Travel', d.title);
---
<Base title={d.title} description={d.excerpt} type="article" publishedTime={d.date} lang={d.lang} schema={schema}
  crumbs={crumbs}
  image={ogImage}
  imageAlt={d.coverAlt || d.title}>
  <article class="wrap travel">
    <p class="back"><a href="/travel/">← Travel</a></p>
    <header>
      <h1>{d.title}</h1>
      <p class="meta">
        {d.location?.name && <span>{d.location.name}{d.location.country ? `, ${d.location.country}` : ''}</span>}
        <time datetime={d.date.toISOString()}>{displayDate(d)}</time>
      </p>
    </header>

    {d.cover && (
      <figure class="travel__figure">
        <Image src={d.cover} alt={d.coverAlt || d.title} width={1100} height={700} />
        {d.coverCaption && <figcaption>{d.coverCaption}</figcaption>}
      </figure>
    )}

    <div class="prose travel__body"><Content /></div>

    {d.gallery.length > 0 && (
      <section class="gallery" aria-label="Photographs">
        {d.gallery.map((g) => (
          <figure class="gallery__item">
            <Image src={g.src} alt={g.alt || `${d.title}`} width={700} height={500} loading="lazy" />
            {g.credit && <figcaption class="gallery__credit">{g.credit}</figcaption>}
          </figure>
        ))}
      </section>
    )}

    {d.tags.length > 0 && (
      <ul class="tag-list travel__tags">
        {d.tags.map((t) => <li><a href={`/tags/${tagSlug(t)}/`}>{t}</a></li>)}
      </ul>
    )}
  </article>
</Base>
<style>
  .travel { max-width: 50rem; }
  .back { margin-block-end: var(--space-5); }
  header .meta { margin-block-start: var(--space-3); }
  .travel__figure { margin-block: var(--space-6) var(--space-7); }
  .travel__figure img { border-radius: var(--radius-lg); width: 100%; }
  .travel__figure figcaption { color: var(--text-muted); font-size: var(--step--1); margin-block-start: var(--space-2); }
  /* No `pre-line` here: travel writing is prose, and a forced line break stops
     a line being justified. Paragraph breaks come from blank lines instead. */
  .gallery { display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); margin-block-start: var(--space-8); }
  .gallery__item { margin: 0; }
  .gallery__item img { border-radius: var(--radius-md); width: 100%; }
  .gallery__credit {
    margin-block-start: var(--space-2);
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .travel__tags { margin-block-start: var(--space-8); }
</style>
