---
import { Image } from 'astro:assets';
import { displayDate } from '../lib/content';

interface Props {
  href: string;
  data: {
    title: string; date: Date; dateNote?: string; lang?: string;
    excerpt?: string; cover?: any; coverAlt?: string; tags?: string[];
    form?: string; status?: string; location?: { name: string };
  };
  /** Small label in the corner, e.g. "Poem" or "Published". */
  kind?: string;
}
const { href, data, kind } = Astro.props;
---
<article class="card">
  {data.cover && (
    <div class="card__media">
      {/* alt="" is correct HERE and only here: this thumbnail sits inside a
          card whose <h3> already carries the title, so describing it again
          makes a screen reader read the same string twice. Entry pages are
          the opposite case — there the cover is standalone content and gets
          a real alt. */}
      <Image src={data.cover} alt={data.coverAlt || ''} width={480} height={320} loading="lazy" />
    </div>
  )}
  <div class="card__body">
    {kind && <span class="badge">{kind}</span>}
    <h3 class="card__title"><a href={href} lang={data.lang}>{data.title}</a></h3>
    {data.excerpt && <p class="card__excerpt" lang={data.lang}>{data.excerpt}</p>}
    <div class="meta">
      <time datetime={data.date.toISOString()}>{displayDate(data)}</time>
      {data.location?.name && <span>{data.location.name}</span>}
    </div>
  </div>
</article>
