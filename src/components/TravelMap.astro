---
/**
 * A map of where the travel entries went.
 *
 * Built entirely at build time: real country outlines from world-atlas are
 * projected to SVG paths here, and the browser receives plain markup. No map
 * library, no tiles, no runtime JavaScript, no external request — the same
 * constraints the rest of the site is built under.
 *
 * The bounding box is computed from the pins, so the map fits whatever has
 * actually been published. Add a trip to Chile and the frame widens by itself.
 */
import { feature } from 'topojson-client';
import worldTopo from 'world-atlas/countries-110m.json';
import { lookupPlace, MODES, type Mode } from '../data/places';

interface Pin {
  name: string;
  lat: number;
  lon: number;
  label: string;
  count: number;
  modes: Mode[];
  href?: string;
}

interface Props {
  entries: { id: string; data: { location?: { name: string }; mode?: Mode } }[];
}
const { entries } = Astro.props;

/* ---- Collect pins, merging repeats of the same place ---- */
const byPlace = new Map<string, Pin>();
for (const e of entries) {
  const p = lookupPlace(e.data.location?.name);
  if (!p) continue;
  const key = `${p.lat},${p.lon}`;
  const hit = byPlace.get(key);
  if (hit) {
    hit.count++;
    if (e.data.mode && !hit.modes.includes(e.data.mode)) hit.modes.push(e.data.mode);
  } else {
    byPlace.set(key, {
      name: p.label, lat: p.lat, lon: p.lon, label: p.label,
      count: 1, modes: e.data.mode ? [e.data.mode] : [],
      href: `/travel/${e.id}/`,
    });
  }
}
const pins = [...byPlace.values()].sort((a, b) => b.count - a.count);

/* ---- Frame the map on the pins, with padding ---- */
const W = 760, H = 520, PAD = 0.18;
const lons = pins.map((p) => p.lon);
const lats = pins.map((p) => p.lat);
// Fall back to Bangladesh if there is nothing to show yet.
const box = pins.length
  ? { w: Math.min(...lons), e: Math.max(...lons), s: Math.min(...lats), n: Math.max(...lats) }
  : { w: 88, e: 93, s: 20.5, n: 26.7 };

const spanLon = Math.max(box.e - box.w, 2) * (1 + PAD * 2);
const spanLat = Math.max(box.n - box.s, 2) * (1 + PAD * 2);
const midLon = (box.w + box.e) / 2;
const midLat = (box.n + box.s) / 2;

// Equirectangular, with the longitude span corrected by cos(latitude) so the
// shapes are not stretched sideways this far from the equator.
const cosLat = Math.cos((midLat * Math.PI) / 180);
const scale = Math.min(W / (spanLon * cosLat), H / spanLat);
const project = (lon: number, lat: number): [number, number] => [
  W / 2 + (lon - midLon) * cosLat * scale,
  H / 2 - (lat - midLat) * scale,
];

/* ---- Country outlines, clipped roughly to the frame ---- */
const world: any = feature(worldTopo as any, (worldTopo as any).objects.countries);
const marginLon = spanLon, marginLat = spanLat;

function ringToPath(ring: number[][]): string | null {
  const pts = ring.map(([lon, lat]) => project(lon, lat));
  // Skip rings entirely outside the frame; at 110m there are ~180 countries
  // and most are irrelevant to a map of Bangladesh and Thailand.
  const inFrame = ring.some(([lon, lat]) =>
    Math.abs(lon - midLon) < marginLon && Math.abs(lat - midLat) < marginLat);
  if (!inFrame) return null;
  return 'M' + pts.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join('L') + 'Z';
}

const paths: string[] = [];
for (const f of world.features) {
  const g = f.geometry;
  if (!g) continue;
  const polys = g.type === 'Polygon' ? [g.coordinates] : g.type === 'MultiPolygon' ? g.coordinates : [];
  for (const poly of polys) {
    for (const ring of poly) {
      const d = ringToPath(ring);
      if (d) paths.push(d);
    }
  }
}

/* ---- Graticule every 5 degrees ---- */
const grat: { x1: number; y1: number; x2: number; y2: number }[] = [];
const step = spanLon > 30 ? 10 : 5;
for (let lon = Math.floor((midLon - spanLon) / step) * step; lon <= midLon + spanLon; lon += step) {
  const [x1, y1] = project(lon, midLat - spanLat);
  const [x2, y2] = project(lon, midLat + spanLat);
  grat.push({ x1, y1, x2, y2 });
}
for (let lat = Math.floor((midLat - spanLat) / step) * step; lat <= midLat + spanLat; lat += step) {
  const [x1, y1] = project(midLon - spanLon, lat);
  const [x2, y2] = project(midLon + spanLon, lat);
  grat.push({ x1, y1, x2, y2 });
}

const placed = pins.map((p) => {
  const [x, y] = project(p.lon, p.lat);
  return { ...p, x, y, r: 4 + Math.min(p.count, 6) * 1.6 };
});

const modeLabel = (m: Mode[]) => m.map((k) => MODES[k]?.label).filter(Boolean).join(' · ');
---
{placed.length > 0 && (
  <figure class="map">
    <svg viewBox={`0 0 ${W} ${H}`} role="img"
         aria-label={`Map of ${placed.length} places visited: ${placed.map((p) => p.label).join(', ')}`}>
      <g class="map__grat">
        {grat.map((l) => <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} />)}
      </g>
      <g class="map__land">
        {paths.map((d) => <path d={d} />)}
      </g>
      <g class="map__pins">
        {placed.map((p) => (
          <g class="map__pin">
            <circle cx={p.x} cy={p.y} r={p.r} />
            <circle class="map__halo" cx={p.x} cy={p.y} r={p.r + 4} />
            <text x={p.x + p.r + 6} y={p.y + 4}>
              {p.label}{p.count > 1 ? ` (${p.count})` : ''}
            </text>
          </g>
        ))}
      </g>
    </svg>
    <figcaption>
      {placed.length} places · pin size shows how many times
      {placed.some((p) => p.modes.length) && <> · {modeLabel([...new Set(placed.flatMap((p) => p.modes))])}</>}
    </figcaption>
  </figure>
)}

<style>
  .map {
    margin: 0 0 var(--space-8);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    overflow: hidden;
  }
  .map svg { width: 100%; height: auto; display: block; }

  .map__grat line { stroke: var(--border); stroke-width: 0.5; opacity: 0.7; }
  .map__land path {
    fill: var(--bg);
    stroke: var(--border-strong);
    stroke-width: 0.8;
    stroke-linejoin: round;
  }

  .map__pin circle { fill: var(--accent-2); }
  .map__pin .map__halo { fill: var(--accent-2); opacity: 0.18; }
  .map__pin text {
    fill: var(--text-muted);
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 0.02em;
  }

  .map figcaption {
    margin-block-start: var(--space-3);
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  /* Labels collide once the frame is only a few hundred pixels wide. */
  @media (max-width: 34rem) {
    .map__pin text { display: none; }
  }
</style>
