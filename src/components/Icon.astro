---
/**
 * The site's icon set. Previously every "icon" was a Unicode glyph (☰ ☾ ↗),
 * which renders differently on every platform and, for the arrows, is read
 * aloud by screen readers as punctuation.
 *
 * Inline SVG paths, no icon font, no sprite request. `aria-hidden` by default
 * because these always sit beside a text label; pass `title` only when an icon
 * genuinely stands alone.
 */
interface Props {
  name: keyof typeof PATHS;
  size?: number;
  title?: string;
  class?: string;
}

const PATHS = {
  external: '<path d="M7 17 17 7M9 7h8v8"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  github:
    '<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.9a3.4 3.4 0 0 0-.9-2.6c3-.3 6.2-1.5 6.2-6.7A5.2 5.2 0 0 0 19.9 5a4.9 4.9 0 0 0-.1-3.6s-1.1-.3-3.6 1.4a12.3 12.3 0 0 0-6.4 0C7.3 1.1 6.2 1.4 6.2 1.4A4.9 4.9 0 0 0 6.1 5a5.2 5.2 0 0 0-1.4 3.6c0 5.2 3.2 6.4 6.2 6.7a3.4 3.4 0 0 0-.9 2.6V22"/>',
  orcid:
    '<circle cx="12" cy="12" r="9"/><path d="M9 8.5v7M9 6.6v.1M13 15.5v-7h2a3.5 3.5 0 0 1 0 7z"/>',
  scholar: '<path d="m12 3 10 6-10 6L2 9l10-6Z"/><path d="M6 11v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5"/>',
  telescope:
    '<path d="m3 14 8-4 2 4-8 4-2-4Z"/><path d="m13 10 6-3 2 4-6 3"/><path d="M9 16v5M6 21h6"/>',
  pen: '<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5Z"/>',
  pin: '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  moon: '<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
  arrowLeft: '<path d="M19 12H5"/><path d="m12 19-7-7 7-7"/>',
} as const;

const { name, size = 18, title, class: className } = Astro.props;
---
<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
  focusable="false"
  set:html={PATHS[name]}
/>

<style>
  .icon { display: inline-block; vertical-align: -0.18em; flex: none; }
</style>
