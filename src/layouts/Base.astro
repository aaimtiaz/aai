---
import '@fontsource-variable/inter';
import '@fontsource-variable/noto-sans-bengali';
import '../styles/global.css';

import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import { siteUpdatedAt } from '../lib/content';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  noindex?: boolean;
  imageAlt?: string;
  crumbs?: { name: string; href: string }[];
  lang?: string;
  schema?: Record<string, unknown>[];
  /** Admin and other tool pages opt out of analytics. */
  analytics?: boolean;
}

const { lang = 'en', analytics = true, ...head } = Astro.props;
const updated = await siteUpdatedAt();
---
<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead {...head} lang={lang} />
    {analytics && !head.noindex && <Analytics />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer updated={updated} />
  </body>
</html>
