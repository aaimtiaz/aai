---
import '@fontsource-variable/inter';
import '@fontsource-variable/noto-sans-bengali';
import '../styles/global.css';

import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import { siteUpdatedAt } from '../lib/content';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  noindex?: boolean;
  imageAlt?: string;
  crumbs?: { name: string; href: string }[];
  lang?: string;
  schema?: Record<string, unknown>[];
  /** Admin and other tool pages opt out of analytics. */
  analytics?: boolean;
}

const { lang = 'en', analytics = true, ...head } = Astro.props;
const updated = await siteUpdatedAt();
---
<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead {...head} lang={lang} />
    {analytics && !head.noindex && <Analytics />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer updated={updated} />

    {/* The in-page editor, for the owner only. This costs a visitor the token
        check and nothing else: the editor is a separate chunk that a dynamic
        import only fetches when there is a token to justify it. */}
    {!head.noindex && (
      <script>
        // The key is read inline rather than through github.ts, so a visitor
        // without a token fetches no module at all — importing the helper to
        // ask whether to import anything would download it for everyone.
        let token = null;
        try {
          token = sessionStorage.getItem('admin_gh_token') ?? localStorage.getItem('admin_gh_token');
        } catch {}
        if (token) import('../scripts/editor/index');
      </script>
    )}
  </body>
</html>
